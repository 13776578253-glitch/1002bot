{
  "extends": "../tsconfig.web.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "../dist"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "../src/**/*.ts",
    "../src/**/*.tsx",
    "../src/**/*.d.ts",
    "../examples/**/*.ts",
    "../examples/**/*.tsx"
  ],
  "exclude": [
    "../src/**/__tests__/**",
    "../src/**/*.test.ts",
    "../src/**/*.test.tsx",
    "dist"
  ]
}
