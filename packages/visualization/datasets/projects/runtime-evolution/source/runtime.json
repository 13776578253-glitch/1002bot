    {
      "id": "runtime",
      "kind": "component",
      "label": "Runtime",
      "summary": "生命周期与 Event 执行的所有者",
      "details": [
        "生命周期：start / stop、启动清理与停止屏障。",
        "执行身份：generation、lease 与异步边界后的失效检查。",
        "Event 循环：协调请求组装、模型响应与工具续轮。",
        "会话事实：读取历史，按发生顺序追加模型与工具记录。",
        "停止收束：等待已进入的写入，并执行 World 有界清理。",
        "运行观察：Runtime trace 保留实例内执行记录。"
      ],
      "contractIds": [
        "Event",
        "Agent",
        "Provider",
        "World",
        "SessionStore",
        "StateStore"
      ],
      "sourceRefs": [
        "docs/进度汇报/2026-10-04-M1.0进度与架构图.md#组件关系",
        "docs/进度汇报/2026-10-04-M1.0进度与架构图.md#详细关系"
      ]
    },
    {
      "id": "console",
      "kind": "actor",
      "label": "Console",
      "summary": "文本编辑、本地命令与诊断",
      "details": [
        "通过 runtime.inputs 提交 UserInput。",
        "订阅诊断、查看快照并补读有限输出。",
        "受理回执与 run_finished 分别表达接收和完成。"
      ],
      "contractIds": [
        "InputReceipt",
        "OutputEvent"
      ],
      "sourceRefs": [
        "docs/进度汇报/2026-10-05-M2.0进度与架构图.md#组件关系",
        "docs/进度汇报/2026-10-05-M2.0进度与架构图.md#详细关系",
        "git:750bc45:src/console/terminal.ts"
      ]
    },
    {
      "id": "input-channel",
      "kind": "component",
      "label": "InputChannel",
      "summary": "FIFO 受理与输入生命周期",
      "details": [
        "受理：去重、容量检查与 accepted / rejected。",
        "调度：单 Session FIFO，出队后创建 runId。",
        "取消：排队输入移除，活动输入发出 abort。",
        "终态：等待最终记录写入，再发布 run_finished。",
        "诊断：inspect、eventsSince、订阅与有限缓存。"
      ],
      "contractIds": [
        "InputReceipt",
        "RunResult",
        "OutputEvent",
        "InputLimits"
      ],
      "sourceRefs": [
        "docs/进度汇报/2026-10-05-M2.0进度与架构图.md#组件关系",
        "docs/进度汇报/2026-10-05-M2.0进度与架构图.md#详细关系",
        "git:750bc45:src/runtime/input-channel.ts"
      ]
    },
    {
      "id": "input-run",
      "kind": "component",
      "label": "InputRun",
      "summary": "一次输入的执行边界",
      "details": [
        "上下文：读取 Session 历史事实，交给 Agent 选择并组装。",
        "调用：计量请求，调用 Provider 和已声明的 World 工具。",
        "约束：单输入期限、子调用信号、容量与轮次。",
        "配对：工具参数形状、callId 与回执匹配。",
        "提交：追加过程事实，结果交回 InputChannel。",
        "unknown：关闭受理并收束；不重试或重放。"
      ],
      "contractIds": [
        "Agent",
        "Provider",
        "World",
        "SessionStore",
        "InputLimits"
      ],
      "sourceRefs": [
        "docs/进度汇报/2026-10-05-M2.0进度与架构图.md#组件关系",
        "docs/进度汇报/2026-10-05-M2.0进度与架构图.md#详细关系",
        "git:750bc45:src/runtime/input-run.ts"
      ]
    }
  ],
