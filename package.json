{
  "name": "1002bot",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types scripts/run-tests.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "sample": "node --experimental-strip-types scripts/m1-sample.ts",
    "dev:console": "node --experimental-strip-types scripts/console-sample.ts",
    "dev:tui": "node --experimental-strip-types scripts/tui-sample.ts",
    "probe:tui": "node --experimental-strip-types scripts/tui-probe.ts",
    "build:core": "tsc -p tsconfig.build.json",
    "build": "pnpm --filter @1002bot/control-api build && pnpm build:core"
  },
  "dependencies": {
    "string-width": "^8.0.0",
    "@1002bot/control-api": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./control": {
      "types": "./dist/control/index.d.ts",
      "import": "./dist/control/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    }
  }
}
