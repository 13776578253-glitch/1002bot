{
  "name": "1002bot",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm build:all && node --experimental-strip-types scripts/run-tests.mjs",
    "typecheck": "pnpm build:all && pnpm typecheck:core && pnpm --filter @1002bot/tui typecheck && pnpm --filter @1002bot/tui-example typecheck && pnpm --filter @1002bot/integration-tests typecheck",
    "sample": "node --experimental-strip-types scripts/m1-sample.ts",
    "dev:console": "node --experimental-strip-types scripts/console-sample.ts",
    "dev:tui": "pnpm build:all && pnpm --filter @1002bot/tui-example dev",
    "probe:tui": "pnpm --filter @1002bot/tui build && pnpm --filter @1002bot/tui probe",
    "build:core": "tsc -p tsconfig.build.json",
    "build": "pnpm --filter @1002bot/control-api build && pnpm build:core",
    "install:core": "pnpm install --config.recursive-install=true --filter 1002bot...",
    "install:tui": "pnpm install --config.recursive-install=true --filter @1002bot/tui...",
    "install:all": "pnpm install --config.recursive-install=true",
    "build:all": "pnpm build && pnpm --filter @1002bot/tui build",
    "test:core": "node --experimental-strip-types scripts/run-tests.mjs --core",
    "typecheck:core": "pnpm --filter @1002bot/control-api build && node scripts/typecheck.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "wt:new": "node scripts/worktree.mjs new",
    "wt:status": "node scripts/worktree.mjs status"
  },
  "dependencies": {
    "@1002bot/control-api": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./control": {
      "types": "./dist/control/index.d.ts",
      "import": "./dist/control/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    }
  }
}
